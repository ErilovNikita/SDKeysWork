# URL инсталляции без пути /sd
NSMP_URL=https://support.example.ru
NSMP_ACCESS_KEY=replace-me

# По умолчанию используется VITE_APP_CODE или имя пакета из package.json
# NSMP_APP_CODE=my-embedded-app
NSMP_APP_TITLE=Моё встроенное приложение
NSMP_APP_MIN_HEIGHT=1000
NSMP_APP_ENABLE=true

# Отключайте проверку TLS только для доверенной тестовой инсталляции.
NSMP_TLS_REJECT_UNAUTHORIZED=true